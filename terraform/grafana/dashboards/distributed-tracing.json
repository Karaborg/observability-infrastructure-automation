{
  "uid": "distributed-tracing",
  "title": "Distributed Tracing",
  "tags": [
    "observability",
    "tracing",
    "tempo",
    "opentelemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "version": 0,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dfoiotr4n13pce"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total, env)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dfoiotr4n13pce"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total, service_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Service Call Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfoiotr4n13pce"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dfoiotr4n13pce"
          },
          "expr": "sum by (service_name) (rate(traces_spanmetrics_calls_total{service_name=~\"$service\",env=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfoiotr4n13pce"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dfoiotr4n13pce"
          },
          "expr": "100 * sum by (service_name) (rate(traces_spanmetrics_calls_total{service_name=~\"$service\",env=~\"$env\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / clamp_min(sum by (service_name) (rate(traces_spanmetrics_calls_total{service_name=~\"$service\",env=~\"$env\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "P95 Latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfoiotr4n13pce"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dfoiotr4n13pce"
          },
          "expr": "1000 * histogram_quantile(0.95, sum by (le, service_name) (rate(traces_spanmetrics_latency_bucket{service_name=~\"$service\",env=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "P99 Latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfoiotr4n13pce"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dfoiotr4n13pce"
          },
          "expr": "1000 * histogram_quantile(0.99, sum by (le, service_name) (rate(traces_spanmetrics_latency_bucket{service_name=~\"$service\",env=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Service-to-Service Traffic",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfoiotr4n13pce"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dfoiotr4n13pce"
          },
          "expr": "sum by (client, server) (rate(traces_service_graph_request_total{connection_type!=\"database\",env=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{client}} \u2192 {{server}}",
          "range": true
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Service Graph Errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfoiotr4n13pce"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dfoiotr4n13pce"
          },
          "expr": "sum by (client, server) (rate(traces_service_graph_request_failed_total{connection_type!=\"database\",env=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{client}} \u2192 {{server}}",
          "range": true
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
